PORT=3000
JWT_SECRET=change_this_to_a_long_random_secret_before_deploying

# Set this to the email address you registered with to get access to the
# Admin Panel (/admin.html) — the list of every registered user, their IDs,
# and platform stats. Takes effect the moment that account next registers
# or logs in — no restart needed.
# ADMIN_EMAIL=you@example.com

# --- Database ---
# By default (nothing set below) the app uses a local SQLite file at
# ./database/blood_donor.db — fine for local development, but on hosts like
# Render's free tier this resets on every restart/redeploy/spin-down.
#
# For real persistence in production, create a free database at turso.tech
# and set these two (see README section "Persistent Database with Turso"):
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-auth-token

# Optional: override the LOCAL SQLite file's location (ignored when
# TURSO_DATABASE_URL is set). Leave unset for local development.
# DB_PATH=/var/data/blood_donor.db
