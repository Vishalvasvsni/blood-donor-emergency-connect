PORT=3000
JWT_SECRET=change_this_to_a_long_random_secret_before_deploying

# Optional: override the SQLite file location (used in production to point
# at a mounted persistent disk, e.g. /var/data/blood_donor.db on Render).
# Leave unset for local development — it defaults to ./database/blood_donor.db
# DB_PATH=/var/data/blood_donor.db
