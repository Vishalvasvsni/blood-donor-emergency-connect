PORT=3000
JWT_SECRET=change_this_to_a_long_random_secret_before_deploying

# Set this to the email address(es) you want promoted to admin — access to
# the Admin Panel (/admin.html), which lists every registered user, their
# IDs, and platform stats. Takes effect the moment that account next
# registers or logs in — no restart needed. Supports multiple emails,
# comma-separated. Beyond this list, any existing admin can also promote
# further users to admin directly from the Admin Panel itself.
# ADMIN_EMAIL=you@example.com
# ADMIN_EMAIL=you@example.com, cofounder@example.com

# --- Database ---
# By default (nothing set below) the app uses a local SQLite file at
# ./database/blood_donor.db — fine for local development, but on hosts like
# Render's free tier this resets on every restart/redeploy/spin-down.
#
# For real persistence in production, create a free database at turso.tech
# and set these two (see README section "Persistent Database with Turso"):
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-auth-token

# Optional: override the LOCAL SQLite file's location (ignored when
# TURSO_DATABASE_URL is set). Leave unset for local development.
# DB_PATH=/var/data/blood_donor.db

# --- Salesforce (optional) ---
# When all four of these are set, every registered user syncs to Salesforce
# as a Contact, and every emergency request syncs as a linked Case — in
# real time, the moment someone registers or posts a request. Leave all
# four unset to run without Salesforce at all (nothing else changes).
# See README section "Salesforce Integration" for the full setup guide.
# SALESFORCE_LOGIN_URL=https://login.salesforce.com
# SALESFORCE_CLIENT_ID=your-connected-app-consumer-key
# SALESFORCE_CLIENT_SECRET=your-connected-app-consumer-secret
# SALESFORCE_USERNAME=you@yourcompany.com
# SALESFORCE_PASSWORD=your-password-concatenated-with-your-security-token

# --- Sign-up verification (OTP for email + mobile number) ---
# New accounts must verify BOTH their email and mobile number with a 6-digit
# code. Set up delivery for each channel (see README "Verification, health
# info, cool-down and blocking"). Render's free tier blocks SMTP, so email
# goes through Brevo's HTTPS API (free: 300 emails/day).
# BREVO_API_KEY=xkeysib-...
# EMAIL_FROM=you@gmail.com            # a sender address verified in Brevo
# EMAIL_FROM_NAME=Blood Donor Emergency Connect
#
# SMS has no free option for Indian numbers. Pick one provider:
# FAST2SMS_API_KEY=...                # India, OTP route (paid per SMS)
# TWILIO_ACCOUNT_SID=...              # or Twilio
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM=+1xxxxxxxxxx
# SMS_COUNTRY_CODE=91
#
# DEMO MODE: for any channel with no provider above, the code is shown on
# screen instead of being sent. Fine for a viva/demo — but it does NOT prove
# the person owns that email/number, so never leave it on for real users.
# OTP_DEV_MODE=true
#
# Escape hatch: turn verification off entirely (not recommended).
# REQUIRE_VERIFICATION=false
#
# Days a donor stays hidden from search after their last donation date.
# DONATION_COOLDOWN_DAYS=30
